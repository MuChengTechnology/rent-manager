{
  "name": "rental-housing-manager-exam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run",
    "test:worker": "node --test tests/worker.test.mjs tests/config.test.mjs",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "build": "npm run typecheck && astro build && npm run build:sw",
    "build:sw": "node scripts/generate-service-worker.mjs",
    "preview": "vite preview --outDir dist --strictPort",
    "preview:cloudflare": "npm run build && wrangler dev",
    "test:e2e": "playwright test",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.13.3",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "8.2.0",
    "vitest": "^4.1.0",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "undici": "7.29.0"
  }
}
